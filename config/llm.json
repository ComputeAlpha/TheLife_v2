{
  "_comment": "LLM gateway providers (agent_lld.md \u00a73.1). Capabilities come from spikes/llm/REPORT.md. Secrets only through api_key_env. THELIFE_LLM_BASE_URL overrides the primary's base_url (tests point it at docker/fake-llm).",
  "providers": [
    {
      "name": "ollama",
      "kind": "openai",
      "role": "primary",
      "base_url": "http://127.0.0.1:11434/v1",
      "api_key_env": "",
      "models": {
        "chat": "glm-5.3-flash:cloud",
        "vision": "glm-5.3-flash:cloud"
      },
      "caps": {
        "tools": true,
        "json_schema": false,
        "vision": true,
        "ctx_tokens": 128000
      },
      "timeout_s": 180,
      "idle_timeout_s": 60
    },
    {
      "name": "fallback",
      "kind": "stub",
      "role": "fallback"
    }
  ],
  "weekly_reset": {
    "iso_weekday": 1,
    "hour": 0,
    "timezone": "Asia/Kolkata"
  },
  "weekly_request_estimate": 3000,
  "web_search": {
    "base_url": "https://ollama.com/api",
    "api_key_env": "OLLAMA_API_KEY",
    "timeout_s": 15,
    "daily_limit": 50
  }
}
